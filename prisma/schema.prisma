generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  member
}

enum UserStatus {
  active
  inactive
}

enum TenantStatus {
  active
  suspended
  cancelled
}

enum AcquisitionChannel {
  organic
  paid_ads
  referral
  content
  outbound_sales
  partnership
  other
}

enum FieldType {
  text
  number
  date
  select
  email
}

enum ContractType {
  part_time
  full_time
}

enum EntityType {
  employee
  client
  company
  contact
  opportunity
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum TimeOffAccrualMethod {
  fixed_annual
  monthly
}

enum TimeOffRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum SavedViewType {
  grid
  kanban
  list
}

enum SavedViewVisibility {
  personal
  shared
}

enum LeadStatus {
  new
  contacted
  qualified
  disqualified
}

// public: the standalone /apply/:tenantSlug/:formSlug page, no auth (today's
// only mode). internal: filled out by a logged-in team member instead of an
// outside visitor — same submit logic either way, this only gates *how* the
// form is reached, added ahead of building that reach-gate.
enum FormAccessMode {
  public
  internal
}

// Which stage of a Pipeline a given PipelineStageDefinition represents, so the
// system can trigger business rules (Opportunity reaching a `won` stage →
// Company.status moves to Customer; `lost` requires Opportunity.lossReasonId)
// without matching on the stage's tenant-renameable `name`.
enum PipelineStageOutcome {
  open
  won
  lost
}

// What kind of deal a Pipeline tracks — independent of its (renameable) name.
// `account` pipelines manage an already-identified company (require a real
// Company, never an ad-hoc one); `lead` pipelines are for unqualified/early
// prospects and tolerate a looser Company match. Drives the Company-required
// gate on Opportunity creation and which Contact detail view renders.
enum PipelineType {
  lead
  account
}

// Payroll (Tier 3.5) — see docs/spec-payroll.md for the full spec, built from
// scratch after two earlier attempts were reverted (git log has the history;
// nothing from them survived to reuse). `profile` never touches Payroll at
// all; `contractor`/`employee` both require at least one EmployeeCompensation
// (enforced at the application layer, Unidad 4/5) — not a schema-level
// concern because pre-existing Employee rows have no value here yet.
enum PersonType {
  profile
  contractor
  employee
}

enum PayFrequencyCadence {
  weekly
  semimonthly
  monthly
}

enum DueDateOffset {
  same_day
  plus_2
  plus_5
  custom
}

// Named distinctly from the retired `CompensationType` enum (hourly/monthly,
// used by the now-removed Employee.compensationType) it replaces — different
// value set (`fixed` instead of `monthly`).
enum PayrollCompensationType {
  hourly
  fixed
}

// Only meaningful when the chosen PaymentMethodDefinition is a bank transfer
// that needs to distinguish IBAN from ACH — any other method (Payoneer,
// Wise, PayPal, ...) just uses a single username/email field instead.
enum PaymentAccountSubType {
  iban
  ach
  username
}

enum PayrollRunStatus {
  draft
  confirmed
}

enum PayrollEntryType {
  base
  bonus
  commission
  reimbursement
  deduction
}

model Tenant {
  id                       String                    @id @default(uuid())
  name                     String
  slug                     String                    @unique
  status                   TenantStatus              @default(active)
  createdAt                DateTime                  @default(now())
  companySize              String?
  industry                 String?
  country                  String?
  acquisitionChannel       AcquisitionChannel?
  currency                 String                    @default("USD") // ISO-4217, tenant-wide default (Opportunity/EmployeeCompensation can override per record)
  users                    User[]
  employees                Employee[]
  clients                  Client[]
  customFieldDefns         CustomFieldDefinition[]
  customFieldValues        CustomFieldValue[]
  invitations              Invitation[]
  statusDefinitions        StatusDefinition[]
  statusHistory            StatusHistoryEntry[]
  timeOffPolicies          TimeOffPolicyDefinition[]
  employeeTimeOffPolicies  EmployeeTimeOffPolicy[]
  timeOffRequests          TimeOffRequest[]
  savedViews               SavedView[]
  forms                    Form[]
  fieldCatalogDefinitions  FieldCatalogDefinition[]
  companies                Company[]
  contacts                 Contact[]
  pipelines                Pipeline[]
  pipelineStages           PipelineStageDefinition[]
  opportunities            Opportunity[]
  opportunityContacts      OpportunityContact[]
  opportunityStageHistory  OpportunityStageHistory[]
  tasks                    Task[]
  notes                    Note[]
  payFrequencyDefinitions  PayFrequencyDefinition[]
  paymentMethodDefinitions PaymentMethodDefinition[]
  employeeCompensations    EmployeeCompensation[]
  payrollRuns              PayrollRun[]
  payrollEntries           PayrollEntry[]
}

model User {
  id                      String                 @id @default(uuid())
  firstName               String
  lastName                String
  phone                   String
  email                   String                 @unique
  passwordHash            String
  role                    UserRole               @default(member)
  status                  UserStatus             @default(active)
  tenantId                String?
  tenant                  Tenant?                @relation(fields: [tenantId], references: [id])
  sessions                Session[]
  sentInvitations         Invitation[]
  employee                Employee?
  statusChanges           StatusHistoryEntry[]
  savedViews              SavedView[]
  acceptedTermsAt         DateTime?
  accountOwnerOfCompanies Company[]
  ownedOpportunities      Opportunity[]
  tasksAssigned           Task[]                 @relation("TaskAssignee")
  tasksCreated            Task[]                 @relation("TaskCreatedBy")
  notesCreated            Note[]
  compensationsCreated    EmployeeCompensation[]
  payrollRunsCreated      PayrollRun[]
}

model Employee {
  id                       String                  @id @default(uuid())
  firstName                String
  lastName                 String
  email                    String
  departmentId             String?
  departmentDefn           FieldCatalogDefinition? @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  jobTitleId               String?
  jobTitleDefn             FieldCatalogDefinition? @relation("EmployeeJobTitle", fields: [jobTitleId], references: [id])
  // hourlyRateCents/monthlyRateCents/compensationType (Tier 2, predates Payroll)
  // retired here (Payroll Unidad 4) in favor of the versioned
  // EmployeeCompensation model — see scripts/backfill-legacy-employee-compensation.ts
  // for the one-time data migration. The physical columns still exist in the
  // database (harmless, unused) until a separate, later, explicitly-approved
  // destructive `db push` — removed here only from the Prisma schema/client so
  // the app stops reading/writing them.
  contractType             ContractType?
  startDate                DateTime?
  endDate                  DateTime?
  contractUrl              String? // link only (e.g. Drive/Dropbox) — no file upload support in the app today
  personalEmail            String? // distinct from `email`, which the UI now labels "Business email"
  personType               PersonType? // Payroll (Unidad 4): profile/contractor/employee — nullable because pre-existing rows predate this field; the People alta form (Unidad 4/5) makes it a required first choice going forward
  nationality              String? // Payroll (Unidad 5): profile data, not part of any EmployeeCompensation contract
  countryOfResidence       String? // Payroll (Unidad 7): filled by the person themselves at contract confirmation, never by the owner
  statusId                 String
  statusDefn               StatusDefinition        @relation(fields: [statusId], references: [id])
  managerId                String?
  manager                  Employee?               @relation("EmployeeManager", fields: [managerId], references: [id])
  reports                  Employee[]              @relation("EmployeeManager")
  tenantId                 String
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id])
  createdAt                DateTime                @default(now())
  userId                   String?                 @unique
  user                     User?                   @relation(fields: [userId], references: [id])
  invitations              Invitation[]
  timeOffPolicies          EmployeeTimeOffPolicy[]
  timeOffRequestsMade      TimeOffRequest[]        @relation("TimeOffRequestEmployee")
  timeOffRequestsToApprove TimeOffRequest[]        @relation("TimeOffRequestApprover")
  compensations            EmployeeCompensation[]
  payrollEntries           PayrollEntry[]

  @@unique([tenantId, email])
}

model Client {
  id         String           @id @default(uuid())
  firstName  String
  lastName   String
  email      String
  company    String
  statusId   String
  statusDefn StatusDefinition @relation(fields: [statusId], references: [id])
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([tenantId, email])
}

// Clients redesign (Company/Contact/Pipeline/Opportunity) — see docs/tareas-desarrollo.md
// lines 389-411 for the full spec. Company/Contact replace the flat `Client` model
// above (kept as-is for now — the data migration from Client to Company+Contact is
// its own later, separate step, not part of this schema-only pass).

model Company {
  id             String                  @id @default(uuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  name           String
  industry       String?
  website        String?
  phone          String?
  billingAddress String? // same field the future Payments module will need — not duplicated
  sizeId         String?
  sizeDefn       FieldCatalogDefinition? @relation(fields: [sizeId], references: [id])
  accountOwnerId String?
  accountOwner   User?                   @relation(fields: [accountOwnerId], references: [id])
  statusId       String // lifecycle status (Prospect/Customer/Churned) — StatusDefinition-based
  statusDefn     StatusDefinition        @relation(fields: [statusId], references: [id]) // like Employee/Client, but never manually edited: derived from Opportunity/Contract events
  createdAt      DateTime                @default(now())
  contacts       Contact[]
  opportunities  Opportunity[]

  @@index([tenantId])
}

model Contact {
  id               String                  @id @default(uuid())
  tenantId         String
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  firstName        String
  lastName         String
  email            String
  phone            String?
  companyId        String? // optional — a lead may not have a confirmed Company yet
  company          Company?                @relation(fields: [companyId], references: [id])
  title            String? // role/title within the company
  isPrimary        Boolean                 @default(false)
  leadStatus       LeadStatus? // only meaningful for leads captured via a public Form
  leadSourceId     String?
  leadSource       FieldCatalogDefinition? @relation(fields: [leadSourceId], references: [id])
  createdAt        DateTime                @default(now())
  opportunityLinks OpportunityContact[]

  @@unique([tenantId, email])
  @@index([tenantId, companyId])
}

model Pipeline {
  id            String                    @id @default(uuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  name          String
  type          PipelineType              @default(lead)
  order         Int                       @default(0)
  isActive      Boolean                   @default(true) // archived when false
  createdAt     DateTime                  @default(now())
  stages        PipelineStageDefinition[]
  opportunities Opportunity[]
  forms         Form[]

  @@index([tenantId])
}

model PipelineStageDefinition {
  id            String                    @id @default(uuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  pipelineId    String
  pipeline      Pipeline                  @relation(fields: [pipelineId], references: [id])
  name          String
  color         String?
  order         Int                       @default(0)
  outcome       PipelineStageOutcome      @default(open)
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  opportunities Opportunity[]
  stageHistory  OpportunityStageHistory[]

  @@index([tenantId, pipelineId])
}

model Opportunity {
  id                 String                    @id @default(uuid())
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id])
  pipelineId         String
  pipeline           Pipeline                  @relation(fields: [pipelineId], references: [id])
  stageId            String
  stage              PipelineStageDefinition   @relation(fields: [stageId], references: [id])
  name               String
  amountCents        Int
  currency           String // ISO-4217, explicit per Opportunity — not the tenant-wide Employee compensation currency
  estimatedCloseDate DateTime?
  ownerId            String
  owner              User                      @relation(fields: [ownerId], references: [id])
  lossReasonId       String? // required at the application layer when stage.outcome === 'lost' — not enforced at the DB level
  lossReason         FieldCatalogDefinition?   @relation(fields: [lossReasonId], references: [id])
  nextStepDate       DateTime?
  nextStepNote       String?
  createdAt          DateTime                  @default(now())
  contactLinks       OpportunityContact[]
  stageHistory       OpportunityStageHistory[]

  @@index([tenantId, pipelineId])
  @@index([tenantId, companyId])
}

model OpportunityContact {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id])
  role          String? // e.g. "decisor" — free text, not a catalog (low cardinality, per-opportunity)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, contactId])
  @@index([tenantId])
}

// Real stageId FK (not a denormalized name snapshot like StatusHistoryEntry) —
// deliberate: the spec asks for stageId specifically, so time-in-stage reporting
// can join back to the live PipelineStageDefinition (color/outcome/order), unlike
// Status's audit-log-style history which snapshots names to survive renames.
model OpportunityStageHistory {
  id            String                  @id @default(uuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  opportunityId String
  opportunity   Opportunity             @relation(fields: [opportunityId], references: [id])
  stageId       String
  stage         PipelineStageDefinition @relation(fields: [stageId], references: [id])
  enteredAt     DateTime                @default(now())

  @@index([tenantId, opportunityId])
}

model StatusDefinition {
  id         String     @id @default(uuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  entityType EntityType
  name       String
  color      String?
  order      Int        @default(0)
  isDefault  Boolean    @default(false)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  employees  Employee[]
  clients    Client[]
  companies  Company[]

  @@index([tenantId, entityType])
}

// Generic tenant-scoped catalog, shared by Department and Job Title (the two Employee
// fields that needed to go from free text to a standardized dropdown). Status is
// deliberately NOT on this mechanism — it's a live, heavily-used feature (Kanban
// grouping, StatusHistoryEntry, isDefault/color) and retrofitting it onto a shared
// model would be a real-data migration for comparatively low reward. See
// docs/tareas-desarrollo.md, Tier 2, for the reasoning.
enum CatalogKind {
  department
  jobTitle
  leadSource
  lossReason
  companySize
}

model FieldCatalogDefinition {
  id                        String        @id @default(uuid())
  tenantId                  String
  tenant                    Tenant        @relation(fields: [tenantId], references: [id])
  kind                      CatalogKind
  name                      String
  order                     Int           @default(0)
  isActive                  Boolean       @default(true)
  createdAt                 DateTime      @default(now())
  employeesByDepartment     Employee[]    @relation("EmployeeDepartment")
  employeesByJobTitle       Employee[]    @relation("EmployeeJobTitle")
  contactsByLeadSource      Contact[]
  opportunitiesByLossReason Opportunity[]
  companiesBySize           Company[]

  @@index([tenantId, kind])
}

model StatusHistoryEntry {
  id              String     @id @default(uuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  entityType      EntityType
  entityId        String
  fromStatusName  String?
  toStatusName    String
  changedByUserId String
  changedBy       User       @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime   @default(now())

  @@index([tenantId, entityType, entityId])
}

model TimeOffPolicyDefinition {
  id                  String                  @id @default(uuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  name                String
  color               String?
  accrualMethod       TimeOffAccrualMethod    @default(fixed_annual)
  daysPerYear         Float
  isPaid              Boolean                 @default(true)
  requiresApproval    Boolean                 @default(true)
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  employeeAssignments EmployeeTimeOffPolicy[]
  requests            TimeOffRequest[]

  @@index([tenantId])
}

model TimeOffRequest {
  id              String                  @id @default(uuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  employeeId      String
  employee        Employee                @relation("TimeOffRequestEmployee", fields: [employeeId], references: [id])
  timeOffPolicyId String
  timeOffPolicy   TimeOffPolicyDefinition @relation(fields: [timeOffPolicyId], references: [id])
  startDate       DateTime
  endDate         DateTime
  daysRequested   Float
  note            String?
  status          TimeOffRequestStatus    @default(pending)
  approverId      String?
  approver        Employee?               @relation("TimeOffRequestApprover", fields: [approverId], references: [id])
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime                @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model EmployeeTimeOffPolicy {
  id              String                  @id @default(uuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  employeeId      String
  employee        Employee                @relation(fields: [employeeId], references: [id])
  timeOffPolicyId String
  timeOffPolicy   TimeOffPolicyDefinition @relation(fields: [timeOffPolicyId], references: [id])
  assignedAt      DateTime                @default(now())

  @@unique([employeeId, timeOffPolicyId])
  @@index([tenantId])
}

// Payroll (Tier 3.5) — docs/spec-payroll.md, Unidad 1. Tenant-level catalog,
// same "configurable, not a fixed enum" precedent as StatusDefinition/
// TimeOffPolicyDefinition — a tenant can rename/reorder/deactivate but never
// hits a hardcoded list of pay schedules.
model PayFrequencyDefinition {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  name              String
  cadence           PayFrequencyCadence
  anchorConfig      String // JSON, shape depends on cadence — see docs/spec-payroll.md Unidad 1
  dueDateOffset     DueDateOffset          @default(same_day)
  dueDateCustomDays Int? // only meaningful when dueDateOffset: custom
  isActive          Boolean                @default(true)
  order             Int                    @default(0)
  createdAt         DateTime               @default(now())
  compensations     EmployeeCompensation[]
  payrollRuns       PayrollRun[]

  @@index([tenantId])
}

// Small tenant-level catalog (Wire transfer/Payoneer/Wise/PayPal seeded by
// default, tenant can add more) — same catalog pattern as above, deliberately
// not folded into FieldCatalogDefinition since it drives conditional form
// fields (IBAN/ACH sub-type) that the generic catalog has no concept of.
model PaymentMethodDefinition {
  id            String                 @id @default(uuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  name          String
  isActive      Boolean                @default(true)
  order         Int                    @default(0)
  createdAt     DateTime               @default(now())
  compensations EmployeeCompensation[]

  @@index([tenantId])
}

// One row per contract version — never a flat field on Employee, so a raise
// or a pay-frequency change preserves history instead of overwriting it. The
// "only one open-ended row per employee" rule (effectiveTo: null) is enforced
// in employeeCompensationService, not at the DB level, same convention as
// StatusDefinition.isDefault.
model EmployeeCompensation {
  id                          String                   @id @default(uuid())
  tenantId                    String
  tenant                      Tenant                   @relation(fields: [tenantId], references: [id])
  employeeId                  String
  employee                    Employee                 @relation(fields: [employeeId], references: [id])
  compensationType            PayrollCompensationType
  rateCents                   Int
  currency                    String
  payFrequencyId              String
  payFrequency                PayFrequencyDefinition   @relation(fields: [payFrequencyId], references: [id])
  jobTitle                    String // snapshot at contract time — intentionally not linked to the People Job Title catalog (FieldCatalogDefinition)
  description                 String
  effectiveFrom               DateTime
  effectiveTo                 DateTime? // null = currently active
  note                        String?
  paymentMethodId             String? // filled by the person at contract confirmation (Unidad 7), not the owner
  paymentMethod               PaymentMethodDefinition? @relation(fields: [paymentMethodId], references: [id])
  paymentAccountSubType       PaymentAccountSubType?
  paymentAccountDataEncrypted String? // AES-256-GCM ciphertext (src/lib/encryption.ts) — never plaintext
  confirmedAt                 DateTime?
  confirmedIp                 String? // evidence captured alongside confirmedAt — docs/spec-payroll.md's "checkbox + timestamp + IP" (Unidad 7)
  blocksParticipation         Boolean                  @default(false) // true only if this is the employee's first-ever EmployeeCompensation, computed once at creation — see Unidad 9
  createdByUserId             String
  createdBy                   User                     @relation(fields: [createdByUserId], references: [id])
  createdAt                   DateTime                 @default(now())
  contractPdf                 Bytes? // generated at creation (draft, unsigned) and overwritten at confirmation (signed, with confirmedAt/confirmedIp evidence baked in) — same column holds whichever version currently applies, so "view"/"resend" always serve the latest state

  @@index([tenantId, employeeId])
}

// A PayrollRun is the mass, per-frequency run (Unidad 12); one-off/off-cycle
// payments (Unidad 18) never create one — they attach PayrollEntry rows
// directly with runId: null. payFrequencyId is nullable here per spec even
// so, for a run created without a preset frequency.
model PayrollRun {
  id              String                  @id @default(uuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  payFrequencyId  String?
  payFrequency    PayFrequencyDefinition? @relation(fields: [payFrequencyId], references: [id])
  periodLabel     String
  status          PayrollRunStatus        @default(draft)
  createdByUserId String
  createdBy       User                    @relation(fields: [createdByUserId], references: [id])
  confirmedAt     DateTime?
  createdAt       DateTime                @default(now())
  entries         PayrollEntry[]

  @@index([tenantId])
}

model PayrollEntry {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  runId       String? // null = a loose entry (off-cycle payment), not part of a PayrollRun
  run         PayrollRun?      @relation(fields: [runId], references: [id])
  type        PayrollEntryType
  amountCents Int // can be negative (deductions)
  currency    String
  hoursQty    Float? // only when compensationType: hourly
  label       String?
  paymentDate DateTime
  createdAt   DateTime         @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, runId])
}

model CustomFieldDefinition {
  id         String             @id @default(uuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  name       String
  entityType EntityType
  fieldType  FieldType
  options    String? // JSON-encoded options for select fields
  required   Boolean            @default(false)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  values     CustomFieldValue[]
}

model CustomFieldValue {
  id                      String                @id @default(uuid())
  tenantId                String
  tenant                  Tenant                @relation(fields: [tenantId], references: [id])
  customFieldDefinitionId String
  customFieldDefinition   CustomFieldDefinition @relation(fields: [customFieldDefinitionId], references: [id])
  entityType              EntityType
  entityId                String
  value                   String
  createdAt               DateTime              @default(now())

  @@index([tenantId, entityType, entityId])
}

// Generic cross-module task, attachable to any entity via the same
// tenantId + entityType + entityId pattern already used by CustomFieldValue —
// no per-module FK. See docs/tareas-desarrollo.md, "Módulo de Tasks", item 1.
model Task {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  entityType  EntityType
  entityId    String
  title       String
  description String?
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  completedAt DateTime? // presence/absence is the done/pending state, not a separate enum
  createdById String
  createdBy   User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, assigneeId])
}

// Same polymorphic tenantId+entityType+entityId pattern as Task — a short
// title + long description (description allows markdown for emphasis, per
// the user 2026-07-29; field names matched to Task's title/description on
// 2026-07-30 for consistency). No assignee (unlike Task, a Note isn't owned
// by anyone but its author) and no completed state — it's a record, not a
// to-do.
model Note {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  entityType  EntityType
  entityId    String
  title       String
  description String
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, entityType, entityId])
}

// @@map keeps the physical table name "PublicForm" — only the Prisma model/
// client name changed to Form (prisma.form.*), avoiding a real ALTER TABLE
// against production data for a purely cosmetic rename (same reasoning that
// kept the table name during Unit 10, now applied the other way: get the
// Form name in code without the DDL risk).
model Form {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  entityType      EntityType
  name            String
  slug            String
  fieldsConfig    String // JSON-encoded array of {key, required} — optional fields only (department/company + cf:<id>); firstName/lastName/email are always shown and required
  thankYouMessage String? // shown after a successful submit; falls back to a generic message when null
  accessMode      FormAccessMode @default(public)
  pipelineId      String? // contact forms only: which Pipeline the auto-created Opportunity lands in, first stage
  pipeline        Pipeline?      @relation(fields: [pipelineId], references: [id])
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("PublicForm")
}

model SavedView {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  entityType      EntityType
  createdByUserId String
  createdBy       User                @relation(fields: [createdByUserId], references: [id])
  name            String
  type            SavedViewType       @default(grid)
  visibility      SavedViewVisibility @default(personal)
  filters         String? // JSON-encoded array of {field, operator, value}
  sortBy          String? // JSON-encoded {field, direction}
  groupByField    String? // kanban/list only: "status" or a CustomFieldDefinition id (select type)
  createdAt       DateTime            @default(now())

  @@index([tenantId, entityType])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Invitation {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  email           String
  role            UserRole         @default(member)
  token           String           @unique
  status          InvitationStatus @default(pending)
  invitedByUserId String
  invitedBy       User             @relation(fields: [invitedByUserId], references: [id])
  employeeId      String?
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  createdAt       DateTime         @default(now())
  expiresAt       DateTime
}
