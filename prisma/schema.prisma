generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  member
}

enum UserStatus {
  active
  inactive
}

enum TenantStatus {
  active
  // trialing/past_due — added for the Subscription Plans flow (spec-subscription-plans.md):
  // trialing = inside the 15-day free trial from signup; past_due = trial lapsed with no
  // payment method, 14-day grace period (full read/write access, just a banner) before
  // moving to suspended. Existing tenants are unaffected (default stays `active`).
  trialing
  past_due
  suspended
  cancelled
}

// "Your role" on the signup survey (spec-tenant-signup.md, Screen 3b) — distinct from
// UserRole (owner/admin/member, the permission enum). Fixed small set, not a per-tenant
// configurable catalog (FieldCatalogDefinition) since it's informational, not something a
// tenant would ever rename/reorder for their own use.
enum JobFunction {
  founder_ceo
  hr
  ops_finance
  sales
  other
}

// Selected on /plans right after signup (spec-subscription-plans.md). Scale has no real
// price/checkout yet — kept in the enum so a tenant can be set to it manually (direct sales
// conversation) even though the pricing page doesn't offer it as a clickable option.
enum PlanTier {
  starter
  growth
  scale
}

// Billing Integration (spec-billing-integration.md) — Paddle (international) vs Mercado Pago
// (Argentina only), routed via resolveProvider() in subscriptionService.ts. Additive: the
// existing Tenant.status/plan/trialEndsAt/gracePeriodEndsAt/lockedPriceCents fields stay as the
// mirror route guards/AppLayout's banner already read — syncSubscriptionAndTenant() becomes the
// single writer for both Subscription and that mirror from here on (cron + the two webhook
// handlers, once built). See the Subscription model below for why plan/lockedPriceCents aren't
// nullable there even though Tenant's are.
enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
}

enum PaymentProvider {
  paddle
  mercadopago
}

// Staff-only, orthogonal to tenant membership. Null = not Northstack staff
// (the normal case for every customer User). Admin Center's login rejects
// anyone with a null platformRole.
enum PlatformRole {
  platform_admin
  platform_support
  platform_viewer
}

enum AcquisitionChannel {
  organic
  paid_ads
  referral
  content
  outbound_sales
  partnership
  other
}

enum FieldType {
  text
  number
  date
  select
  email
}

enum ContractType {
  part_time
  full_time
}

enum EntityType {
  employee
  client
  company
  contact
  opportunity
  ticket
  idea
}

// Platform-wide (Alejandro/soporte), not per-tenant -- unlike StatusDefinition
// (a per-tenant catalog), Tickets/Ideas belong to Northstack itself, so
// there's exactly one catalog of statuses per entity type across the whole
// platform, not one per tenant.
enum PlatformEntityType {
  ticket
  idea
}

model PlatformStatusDefinition {
  id         String             @id @default(uuid())
  entityType PlatformEntityType
  key        String // slug interno, ej. "under_review"
  label      String // texto mostrado en la UI, editable
  order      Int
  isDefault  Boolean            @default(false) // el que toma un registro nuevo al crearse
  isTerminal Boolean            @default(false) // cuenta como "cerrado" en filtros rápidos
  active     Boolean            @default(true) // desactivar en vez de borrar si ya está en uso
  color      String? // mismo patrón que StatusDefinition.color (por-tenant) -- hex, editable en Settings
  tickets    Ticket[]
  ideas      Idea[]

  @@unique([entityType, key])
}

model Ticket {
  id               String                   @id @default(uuid())
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  userId           String? // nullable si soporte lo carga sin identificar a nadie puntual
  user             User?                    @relation("TicketReporter", fields: [userId], references: [id])
  createdByType    String // 'user' | 'platform_staff'
  assignedToUserId String?
  assignedTo       User?                    @relation("TicketAssignee", fields: [assignedToUserId], references: [id])
  subject          String
  description      String
  statusId         String
  status           PlatformStatusDefinition @relation(fields: [statusId], references: [id])
  createdAt        DateTime                 @default(now())
}

// Sin assignedToUserId -- no es un flujo de asignación de soporte, es
// trabajo de producto de Alejandro.
model Idea {
  id            String                   @id @default(uuid())
  tenantId      String
  tenant        Tenant                   @relation(fields: [tenantId], references: [id])
  userId        String?
  user          User?                    @relation("IdeaReporter", fields: [userId], references: [id])
  createdByType String
  subject       String
  description   String
  statusId      String
  status        PlatformStatusDefinition @relation(fields: [statusId], references: [id])
  createdAt     DateTime                 @default(now())
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum TimeOffAccrualMethod {
  fixed_annual
  monthly
}

enum TimeOffRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum SavedViewType {
  grid
  kanban
  list
}

enum SavedViewVisibility {
  personal
  shared
}

enum LeadStatus {
  new
  contacted
  qualified
  disqualified
}

// public: the standalone /apply/:tenantSlug/:formSlug page, no auth (today's
// only mode). internal: filled out by a logged-in team member instead of an
// outside visitor — same submit logic either way, this only gates *how* the
// form is reached, added ahead of building that reach-gate.
enum FormAccessMode {
  public
  internal
}

// Which stage of a Pipeline a given PipelineStageDefinition represents, so the
// system can trigger business rules (Opportunity reaching a `won` stage →
// Company.status moves to Customer; `lost` requires Opportunity.lossReasonId)
// without matching on the stage's tenant-renameable `name`.
enum PipelineStageOutcome {
  open
  won
  lost
}

// What kind of deal a Pipeline tracks — independent of its (renameable) name.
// `account` pipelines manage an already-identified company (require a real
// Company, never an ad-hoc one); `lead` pipelines are for unqualified/early
// prospects and tolerate a looser Company match. Drives the Company-required
// gate on Opportunity creation and which Contact detail view renders.
enum PipelineType {
  lead
  account
}

// Payroll (Tier 3.5) — see docs/spec-payroll.md for the full spec, built from
// scratch after two earlier attempts were reverted (git log has the history;
// nothing from them survived to reuse). `profile` never touches Payroll at
// all; `contractor`/`employee` both require at least one EmployeeCompensation
// (enforced at the application layer, Unidad 4/5) — not a schema-level
// concern because pre-existing Employee rows have no value here yet.
enum PersonType {
  profile
  contractor
  employee
}

enum PayFrequencyCadence {
  weekly
  semimonthly
  monthly
}

enum DueDateOffset {
  same_day
  plus_2
  plus_5
  custom
}

// Named distinctly from the retired `CompensationType` enum (hourly/monthly,
// used by the now-removed Employee.compensationType) it replaces — different
// value set (`fixed` instead of `monthly`).
enum PayrollCompensationType {
  hourly
  fixed
}

// Only meaningful when the chosen PaymentMethodDefinition is a bank transfer
// that needs to distinguish IBAN from ACH — any other method (Payoneer,
// Wise, PayPal, ...) just uses a single username/email field instead.
enum PaymentAccountSubType {
  iban
  ach
  username
}

enum PayrollRunStatus {
  draft
  confirmed
}

enum PayrollEntryType {
  base
  bonus
  commission
  reimbursement
  deduction
}

model Tenant {
  id                       String                    @id @default(uuid())
  name                     String
  slug                     String                    @unique
  status                   TenantStatus              @default(active)
  createdAt                DateTime                  @default(now())
  companySize              String?
  industry                 String?
  country                  String?
  acquisitionChannel       AcquisitionChannel?
  currency                 String                    @default("USD") // ISO-4217, tenant-wide default (Opportunity/EmployeeCompensation can override per record)
  // Subscription Plans (spec-subscription-plans.md) — all nullable/additive, no billing
  // provider integrated yet (Paddle is a separate, later round). trialEndsAt is set once at
  // registration; plan/lockedPriceCents/lockedPriceSetAt are set by PATCH /api/tenants/me/plan;
  // gracePeriodEndsAt is set by the plan-transitions job the first time a tenant lapses.
  plan                     PlanTier?
  trialEndsAt              DateTime?
  gracePeriodEndsAt        DateTime?
  lockedPriceCents         Int?
  lockedPriceSetAt         DateTime?
  subscription             Subscription?
  users                    User[]
  employees                Employee[]
  clients                  Client[]
  customFieldDefns         CustomFieldDefinition[]
  customFieldValues        CustomFieldValue[]
  invitations              Invitation[]
  statusDefinitions        StatusDefinition[]
  statusHistory            StatusHistoryEntry[]
  timeOffPolicies          TimeOffPolicyDefinition[]
  employeeTimeOffPolicies  EmployeeTimeOffPolicy[]
  timeOffRequests          TimeOffRequest[]
  savedViews               SavedView[]
  forms                    Form[]
  fieldCatalogDefinitions  FieldCatalogDefinition[]
  companies                Company[]
  contacts                 Contact[]
  pipelines                Pipeline[]
  pipelineStages           PipelineStageDefinition[]
  opportunities            Opportunity[]
  opportunityContacts      OpportunityContact[]
  opportunityStageHistory  OpportunityStageHistory[]
  tasks                    Task[]
  notes                    Note[]
  tickets                  Ticket[]
  ideas                    Idea[]
  payFrequencyDefinitions  PayFrequencyDefinition[]
  paymentMethodDefinitions PaymentMethodDefinition[]
  employeeCompensations    EmployeeCompensation[]
  payrollRuns              PayrollRun[]
  payrollEntries           PayrollEntry[]
  googleCalendarConnections GoogleCalendarConnection[]
  timeOffCalendarSyncs      TimeOffCalendarSync[]
}

// Billing Integration (spec-billing-integration.md). plan/lockedPriceCents are deliberately NOT
// nullable, unlike the equivalent Tenant fields above: a tenant that hasn't explicitly picked a
// plan yet (Tenant.plan still null) gets a 'starter'-priced placeholder Subscription instead —
// see registerTenantWithOwner (tenantService.ts) and scripts/backfill-billing-subscriptions.ts.
// updateTenantPlan (planService.ts) overwrites the placeholder with the real choice the moment
// the tenant picks one, so nothing here ever gets charged against an unconfirmed guess.
model Subscription {
  id                      String             @id @default(uuid())
  tenantId                String             @unique // 1:1 — one live subscription per tenant
  tenant                  Tenant             @relation(fields: [tenantId], references: [id])
  plan                    PlanTier
  status                  SubscriptionStatus @default(trialing)
  provider                PaymentProvider? // null until a payment method is actually attached
  externalSubscriptionId  String? // Paddle subscription id, or Mercado Pago preapproval_id
  lockedPriceCents        Int
  currency                String // "USD" (Paddle) | "ARS" (Mercado Pago)
  trialEndsAt             DateTime?
  gracePeriodEndsAt       DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelledAt             DateTime? // when cancellation was requested
  cancellationEffectiveAt DateTime? // = currentPeriodEnd at the moment of the request
  cancellationReason      String?
  paymentMethodBrand      String? // "visa" | "mastercard" | etc — display only, never sensitive
  paymentMethodLast4      String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  invoices                Invoice[]

  @@index([provider, status])
}

model Invoice {
  id                String          @id @default(uuid())
  subscriptionId    String
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id])
  provider          PaymentProvider
  externalInvoiceId String?
  amountCents       Int
  currency          String
  status            String // paid | failed | refunded
  periodStart       DateTime
  periodEnd         DateTime
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  @@index([subscriptionId])
}

// Price catalog by plan+market (spec-billing-integration.md). A price change never edits an
// existing row — lockedPriceCents on Subscription already freezes what a tenant is actually
// charged — it inserts a new row with a later effectiveFrom instead.
model PlanPrice {
  id                String   @id @default(uuid())
  plan              PlanTier
  market            String // "international" | "ar"
  currency          String // "USD" | "ARS"
  launchPriceCents  Int
  regularPriceCents Int
  effectiveFrom     DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([plan, market])
}

// Webhook idempotency (spec's webhook contract: insert-then-process). @@unique makes a
// concurrent duplicate delivery fail the insert instead of double-processing, even under a race.
model ProcessedWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  externalEventId String
  processedAt     DateTime        @default(now())

  @@unique([provider, externalEventId])
}

model User {
  id                      String                 @id @default(uuid())
  firstName               String
  lastName                String
  phone                   String
  email                   String                 @unique
  // Lowercased domain portion of `email`, set at create time (src/lib/email.ts's
  // getEmailDomain) — lets checkEmailDomainNotAlreadyRegistered (tenantService.ts) do an
  // indexed equality lookup instead of an `endsWith` scan of the whole table, which can't use
  // a btree index. Nullable because it predates existing rows — see
  // scripts/backfill-user-email-domain.ts, run once after this column is added.
  emailDomain             String?
  passwordHash            String
  role                    UserRole               @default(member)
  status                  UserStatus             @default(active)
  platformRole            PlatformRole?
  createdAt               DateTime               @default(now())
  tenantId                String?
  tenant                  Tenant?                @relation(fields: [tenantId], references: [id])
  sessions                Session[]
  sentInvitations         Invitation[]
  employee                Employee?
  statusChanges           StatusHistoryEntry[]
  savedViews              SavedView[]
  acceptedTermsAt         DateTime?
  jobFunction             JobFunction?
  accountOwnerOfCompanies Company[]
  ownedOpportunities      Opportunity[]
  tasksAssigned           Task[]                 @relation("TaskAssignee")
  tasksCreated            Task[]                 @relation("TaskCreatedBy")
  notesCreated            Note[]
  ticketsReported         Ticket[]               @relation("TicketReporter")
  ticketsAssignedTo       Ticket[]               @relation("TicketAssignee")
  ideasReported           Idea[]                 @relation("IdeaReporter")
  compensationsCreated    EmployeeCompensation[]
  payrollRunsCreated      PayrollRun[]
  passwordResetTokens     PasswordResetToken[]
  googleCalendarConnection GoogleCalendarConnection?
  timeOffCalendarSyncs    TimeOffCalendarSync[]
  googleCalendarWatchChannel GoogleCalendarWatchChannel?

  @@index([emailDomain])
}

// "Forgot your password?" magic link — single-use, short-lived (1h, see
// PASSWORD_RESET_EXPIRY_MS in authService.ts). usedAt doubles as both the
// consumed-flag and an audit trail of when it was actually used, so no
// separate status enum like Invitation's — a reset token only ever has two
// states (unused/used), it doesn't need pending/revoked.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Tenant Signup — email verification (spec-tenant-signup.md). No FK to User/Tenant on
// purpose: this token exists *before* either is created (Screen 1, before the survey even
// starts) — registerTenantWithOwner consumes it as plain evidence "this email was verified",
// then deletes the row. No `usedAt`/status field: a stale/superseded row is deleted outright
// (see emailVerificationService.ts) rather than marked invalid, since nothing else needs to
// read a dead row afterward.
model EmailVerification {
  id         String    @id @default(uuid())
  email      String
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Employee {
  id                       String                  @id @default(uuid())
  firstName                String
  lastName                 String
  email                    String
  departmentId             String?
  departmentDefn           FieldCatalogDefinition? @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  jobTitleId               String?
  jobTitleDefn             FieldCatalogDefinition? @relation("EmployeeJobTitle", fields: [jobTitleId], references: [id])
  // hourlyRateCents/monthlyRateCents/compensationType (Tier 2, predates Payroll)
  // retired here (Payroll Unidad 4) in favor of the versioned
  // EmployeeCompensation model — see scripts/backfill-legacy-employee-compensation.ts
  // for the one-time data migration. The physical columns still exist in the
  // database (harmless, unused) until a separate, later, explicitly-approved
  // destructive `db push` — removed here only from the Prisma schema/client so
  // the app stops reading/writing them.
  contractType             ContractType?
  startDate                DateTime?
  endDate                  DateTime?
  contractUrl              String? // link only (e.g. Drive/Dropbox) — no file upload support in the app today
  personalEmail            String? // distinct from `email`, which the UI now labels "Business email"
  personType               PersonType? // Payroll (Unidad 4): profile/contractor/employee — nullable because pre-existing rows predate this field; the People alta form (Unidad 4/5) makes it a required first choice going forward
  nationality              String? // Payroll (Unidad 5): profile data, not part of any EmployeeCompensation contract
  countryOfResidence       String? // Payroll (Unidad 7): filled by the person themselves at contract confirmation, never by the owner
  birthdate                DateTime?               @db.Date // shown as a recurring annual entry on the Overview calendar (month+day only, year ignored)
  statusId                 String
  statusDefn               StatusDefinition        @relation(fields: [statusId], references: [id])
  managerId                String?
  manager                  Employee?               @relation("EmployeeManager", fields: [managerId], references: [id])
  reports                  Employee[]              @relation("EmployeeManager")
  tenantId                 String
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id])
  createdAt                DateTime                @default(now())
  userId                   String?                 @unique
  user                     User?                   @relation(fields: [userId], references: [id])
  invitations              Invitation[]
  timeOffPolicies          EmployeeTimeOffPolicy[]
  timeOffRequestsMade      TimeOffRequest[]        @relation("TimeOffRequestEmployee")
  timeOffRequestsToApprove TimeOffRequest[]        @relation("TimeOffRequestApprover")
  compensations            EmployeeCompensation[]
  payrollEntries           PayrollEntry[]

  @@unique([tenantId, email])
}

model Client {
  id         String           @id @default(uuid())
  firstName  String
  lastName   String
  email      String
  company    String
  statusId   String
  statusDefn StatusDefinition @relation(fields: [statusId], references: [id])
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([tenantId, email])
}

// Clients redesign (Company/Contact/Pipeline/Opportunity) — see docs/tareas-desarrollo.md
// lines 389-411 for the full spec. Company/Contact replace the flat `Client` model
// above (kept as-is for now — the data migration from Client to Company+Contact is
// its own later, separate step, not part of this schema-only pass).

model Company {
  id             String                  @id @default(uuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  name           String
  industry       String?
  website        String?
  phone          String?
  billingAddress String? // same field the future Payments module will need — not duplicated
  // Self-referential, one level of parent/subsidiary — anti-cycle validated in
  // companyService.ts (wouldCreateCompanyHierarchyCycle, same walk-the-chain
  // pattern as Employee.managerId's wouldCreateManagerCycle). Deleting a
  // Company always unlinks its direct children (parentCompanyId -> null)
  // unless the caller opts into cascading the delete — see deleteCompany.
  parentCompanyId String?
  parentCompany   Company?                @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies  Company[]               @relation("CompanyHierarchy")
  sizeId         String?
  sizeDefn       FieldCatalogDefinition? @relation(fields: [sizeId], references: [id])
  accountOwnerId String?
  accountOwner   User?                   @relation(fields: [accountOwnerId], references: [id])
  statusId       String // lifecycle status (Prospect/Customer/Churned) — StatusDefinition-based
  statusDefn     StatusDefinition        @relation(fields: [statusId], references: [id]) // like Employee/Client, but never manually edited: derived from Opportunity/Contract events
  // Set only by the ad-hoc "create a Company for this Contact" flow off a
  // `lead`-type Pipeline (ContactDetailModal.tsx's handleCreateOpportunity) —
  // never true for a Company created from /companies or a public Form. Marks
  // "still needs a human to fill in real details" so an `account`-type
  // Pipeline can require an already-identified Company (see
  // src/routes/opportunities.ts's validateOpportunityRefs) without confusing
  // a placeholder for a confirmed one. Cleared explicitly (not on every edit)
  // once the Sales v2 "close a won lead" flow exists — see
  // docs/tareas/specredisenosalesv2.md §3.6.
  isPlaceholder  Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  contacts       Contact[]
  opportunities  Opportunity[]

  @@index([tenantId])
}

model Contact {
  id               String                  @id @default(uuid())
  tenantId         String
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  firstName        String
  lastName         String
  email            String
  phone            String?
  companyId        String? // optional — a lead may not have a confirmed Company yet
  company          Company?                @relation(fields: [companyId], references: [id])
  title            String? // role/title within the company
  isPrimary        Boolean                 @default(false)
  leadStatus       LeadStatus? // only meaningful for leads captured via a public Form
  leadSourceId     String?
  leadSource       FieldCatalogDefinition? @relation(fields: [leadSourceId], references: [id])
  createdAt        DateTime                @default(now())
  opportunityLinks OpportunityContact[]

  @@unique([tenantId, email])
  @@index([tenantId, companyId])
}

model Pipeline {
  id            String                    @id @default(uuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  name          String
  type          PipelineType              @default(lead)
  order         Int                       @default(0)
  isActive      Boolean                   @default(true) // archived when false
  createdAt     DateTime                  @default(now())
  stages        PipelineStageDefinition[]
  opportunities Opportunity[]
  forms         Form[]

  @@index([tenantId])
}

model PipelineStageDefinition {
  id            String                    @id @default(uuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  pipelineId    String
  pipeline      Pipeline                  @relation(fields: [pipelineId], references: [id])
  name          String
  color         String?
  order         Int                       @default(0)
  outcome       PipelineStageOutcome      @default(open)
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  opportunities Opportunity[]
  stageHistory  OpportunityStageHistory[]

  @@index([tenantId, pipelineId])
}

model Opportunity {
  id                 String                    @id @default(uuid())
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id])
  pipelineId         String
  pipeline           Pipeline                  @relation(fields: [pipelineId], references: [id])
  stageId            String
  stage              PipelineStageDefinition   @relation(fields: [stageId], references: [id])
  name               String
  amountCents        Int
  currency           String // ISO-4217, explicit per Opportunity — not the tenant-wide Employee compensation currency
  estimatedCloseDate DateTime?
  ownerId            String
  owner              User                      @relation(fields: [ownerId], references: [id])
  lossReasonId       String? // required at the application layer when stage.outcome === 'lost' — not enforced at the DB level
  lossReason         FieldCatalogDefinition?   @relation(fields: [lossReasonId], references: [id])
  nextStepDate       DateTime?
  nextStepNote       String?
  createdAt          DateTime                  @default(now())
  contactLinks       OpportunityContact[]
  stageHistory       OpportunityStageHistory[]

  @@index([tenantId, pipelineId])
  @@index([tenantId, companyId])
}

model OpportunityContact {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id])
  role          String? // e.g. "decisor" — free text, not a catalog (low cardinality, per-opportunity)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, contactId])
  @@index([tenantId])
}

// Real stageId FK (not a denormalized name snapshot like StatusHistoryEntry) —
// deliberate: the spec asks for stageId specifically, so time-in-stage reporting
// can join back to the live PipelineStageDefinition (color/outcome/order), unlike
// Status's audit-log-style history which snapshots names to survive renames.
model OpportunityStageHistory {
  id            String                  @id @default(uuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  opportunityId String
  opportunity   Opportunity             @relation(fields: [opportunityId], references: [id])
  stageId       String
  stage         PipelineStageDefinition @relation(fields: [stageId], references: [id])
  enteredAt     DateTime                @default(now())

  @@index([tenantId, opportunityId])
}

model StatusDefinition {
  id         String     @id @default(uuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  entityType EntityType
  name       String
  color      String?
  order      Int        @default(0)
  isDefault  Boolean    @default(false)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  employees  Employee[]
  clients    Client[]
  companies  Company[]

  @@index([tenantId, entityType])
}

// Generic tenant-scoped catalog, shared by Department and Job Title (the two Employee
// fields that needed to go from free text to a standardized dropdown). Status is
// deliberately NOT on this mechanism — it's a live, heavily-used feature (Kanban
// grouping, StatusHistoryEntry, isDefault/color) and retrofitting it onto a shared
// model would be a real-data migration for comparatively low reward. See
// docs/tareas-desarrollo.md, Tier 2, for the reasoning.
enum CatalogKind {
  department
  jobTitle
  leadSource
  lossReason
  companySize
}

model FieldCatalogDefinition {
  id                        String        @id @default(uuid())
  tenantId                  String
  tenant                    Tenant        @relation(fields: [tenantId], references: [id])
  kind                      CatalogKind
  name                      String
  order                     Int           @default(0)
  isActive                  Boolean       @default(true)
  createdAt                 DateTime      @default(now())
  employeesByDepartment     Employee[]    @relation("EmployeeDepartment")
  employeesByJobTitle       Employee[]    @relation("EmployeeJobTitle")
  contactsByLeadSource      Contact[]
  opportunitiesByLossReason Opportunity[]
  companiesBySize           Company[]

  @@index([tenantId, kind])
}

model StatusHistoryEntry {
  id              String     @id @default(uuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  entityType      EntityType
  entityId        String
  fromStatusName  String?
  toStatusName    String
  changedByUserId String
  changedBy       User       @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime   @default(now())

  @@index([tenantId, entityType, entityId])
}

model TimeOffPolicyDefinition {
  id                  String                  @id @default(uuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  name                String
  color               String?
  accrualMethod       TimeOffAccrualMethod    @default(fixed_annual)
  daysPerYear         Float
  isPaid              Boolean                 @default(true)
  requiresApproval    Boolean                 @default(true)
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  employeeAssignments EmployeeTimeOffPolicy[]
  requests            TimeOffRequest[]

  @@index([tenantId])
}

model TimeOffRequest {
  id              String                  @id @default(uuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  employeeId      String
  employee        Employee                @relation("TimeOffRequestEmployee", fields: [employeeId], references: [id])
  timeOffPolicyId String
  timeOffPolicy   TimeOffPolicyDefinition @relation(fields: [timeOffPolicyId], references: [id])
  startDate       DateTime
  endDate         DateTime
  daysRequested   Float
  note            String?
  status          TimeOffRequestStatus    @default(pending)
  approverId      String?
  approver        Employee?               @relation("TimeOffRequestApprover", fields: [approverId], references: [id])
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime                @default(now())
  calendarSyncs   TimeOffCalendarSync[]

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

// One row per (approved TimeOffRequest, connected user who can see it) —
// team-wide visibility by design (2026-08-23, Alejandro's explicit call):
// every user who connects Google Calendar sees every tenant employee's
// approved time off on their own calendar, same as the shared team calendar
// already on the Overview page, not just their own. A single
// googleCalendarEventId on TimeOffRequest itself isn't enough once one
// request fans out to N different people's calendars — each gets its own
// Google event id. See googleCalendarSyncService.ts.
model TimeOffCalendarSync {
  id                    String          @id @default(uuid())
  tenantId              String
  tenant                Tenant          @relation(fields: [tenantId], references: [id])
  timeOffRequestId      String
  timeOffRequest        TimeOffRequest  @relation(fields: [timeOffRequestId], references: [id])
  userId                String
  user                  User            @relation(fields: [userId], references: [id])
  googleCalendarEventId String
  createdAt             DateTime        @default(now())

  @@unique([timeOffRequestId, userId])
  @@index([tenantId])
}

model EmployeeTimeOffPolicy {
  id              String                  @id @default(uuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  employeeId      String
  employee        Employee                @relation(fields: [employeeId], references: [id])
  timeOffPolicyId String
  timeOffPolicy   TimeOffPolicyDefinition @relation(fields: [timeOffPolicyId], references: [id])
  assignedAt      DateTime                @default(now())

  @@unique([employeeId, timeOffPolicyId])
  @@index([tenantId])
}

// Payroll (Tier 3.5) — docs/spec-payroll.md, Unidad 1. Tenant-level catalog,
// same "configurable, not a fixed enum" precedent as StatusDefinition/
// TimeOffPolicyDefinition — a tenant can rename/reorder/deactivate but never
// hits a hardcoded list of pay schedules.
model PayFrequencyDefinition {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  name              String
  cadence           PayFrequencyCadence
  anchorConfig      String // JSON, shape depends on cadence — see docs/spec-payroll.md Unidad 1
  dueDateOffset     DueDateOffset          @default(same_day)
  dueDateCustomDays Int? // only meaningful when dueDateOffset: custom
  isActive          Boolean                @default(true)
  order             Int                    @default(0)
  createdAt         DateTime               @default(now())
  compensations     EmployeeCompensation[]
  payrollRuns       PayrollRun[]

  @@index([tenantId])
}

// Small tenant-level catalog (Wire transfer/Payoneer/Wise/PayPal seeded by
// default, tenant can add more) — same catalog pattern as above, deliberately
// not folded into FieldCatalogDefinition since it drives conditional form
// fields (IBAN/ACH sub-type) that the generic catalog has no concept of.
model PaymentMethodDefinition {
  id            String                 @id @default(uuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  name          String
  isActive      Boolean                @default(true)
  order         Int                    @default(0)
  createdAt     DateTime               @default(now())
  compensations EmployeeCompensation[]

  @@index([tenantId])
}

// One row per contract version — never a flat field on Employee, so a raise
// or a pay-frequency change preserves history instead of overwriting it. The
// "only one open-ended row per employee" rule (effectiveTo: null) is enforced
// in employeeCompensationService, not at the DB level, same convention as
// StatusDefinition.isDefault.
model EmployeeCompensation {
  id                          String                   @id @default(uuid())
  tenantId                    String
  tenant                      Tenant                   @relation(fields: [tenantId], references: [id])
  employeeId                  String
  employee                    Employee                 @relation(fields: [employeeId], references: [id])
  compensationType            PayrollCompensationType
  rateCents                   Int
  currency                    String
  payFrequencyId              String
  payFrequency                PayFrequencyDefinition   @relation(fields: [payFrequencyId], references: [id])
  jobTitle                    String // snapshot at contract time — intentionally not linked to the People Job Title catalog (FieldCatalogDefinition)
  description                 String
  effectiveFrom               DateTime
  effectiveTo                 DateTime? // null = currently active
  note                        String?
  paymentMethodId             String? // filled by the person at contract confirmation (Unidad 7), not the owner
  paymentMethod               PaymentMethodDefinition? @relation(fields: [paymentMethodId], references: [id])
  paymentAccountSubType       PaymentAccountSubType?
  paymentAccountDataEncrypted String? // AES-256-GCM ciphertext (src/lib/encryption.ts) — never plaintext
  confirmedAt                 DateTime?
  confirmedIp                 String? // evidence captured alongside confirmedAt — docs/spec-payroll.md's "checkbox + timestamp + IP" (Unidad 7)
  blocksParticipation         Boolean                  @default(false) // true only if this is the employee's first-ever EmployeeCompensation, computed once at creation — see Unidad 9
  createdByUserId             String
  createdBy                   User                     @relation(fields: [createdByUserId], references: [id])
  createdAt                   DateTime                 @default(now())
  contractPdf                 Bytes? // generated at creation (draft, unsigned) and overwritten at confirmation (signed, with confirmedAt/confirmedIp evidence baked in) — same column holds whichever version currently applies, so "view"/"resend" always serve the latest state

  @@index([tenantId, employeeId])
}

// A PayrollRun is the mass, per-frequency run (Unidad 12); one-off/off-cycle
// payments (Unidad 18) never create one — they attach PayrollEntry rows
// directly with runId: null. payFrequencyId is nullable here per spec even
// so, for a run created without a preset frequency.
model PayrollRun {
  id              String                  @id @default(uuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  payFrequencyId  String?
  payFrequency    PayFrequencyDefinition? @relation(fields: [payFrequencyId], references: [id])
  periodLabel     String
  status          PayrollRunStatus        @default(draft)
  createdByUserId String
  createdBy       User                    @relation(fields: [createdByUserId], references: [id])
  confirmedAt     DateTime?
  createdAt       DateTime                @default(now())
  entries         PayrollEntry[]

  @@index([tenantId])
}

model PayrollEntry {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  runId       String? // null = a loose entry (off-cycle payment), not part of a PayrollRun
  run         PayrollRun?      @relation(fields: [runId], references: [id])
  type        PayrollEntryType
  amountCents Int // can be negative (deductions)
  currency    String
  hoursQty    Float? // only when compensationType: hourly
  label       String?
  paymentDate DateTime
  createdAt   DateTime         @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, runId])
}

model CustomFieldDefinition {
  id         String             @id @default(uuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  name       String
  entityType EntityType
  fieldType  FieldType
  options    String? // JSON-encoded options for select fields
  required   Boolean            @default(false)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  values     CustomFieldValue[]
}

model CustomFieldValue {
  id                      String                @id @default(uuid())
  tenantId                String
  tenant                  Tenant                @relation(fields: [tenantId], references: [id])
  customFieldDefinitionId String
  customFieldDefinition   CustomFieldDefinition @relation(fields: [customFieldDefinitionId], references: [id])
  entityType              EntityType
  entityId                String
  value                   String
  createdAt               DateTime              @default(now())

  @@index([tenantId, entityType, entityId])
}

// Generic cross-module task, attachable to any entity via the same
// tenantId + entityType + entityId pattern already used by CustomFieldValue —
// no per-module FK. See docs/tareas-desarrollo.md, "Módulo de Tasks", item 1.
model Task {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  entityType  EntityType
  entityId    String
  title       String
  description String?
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  completedAt DateTime? // presence/absence is the done/pending state, not a separate enum
  createdById String
  createdBy   User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  googleCalendarEventId String? // set once this task's dueDate has been pushed to the assignee's connected Google Calendar; see googleCalendarSyncService.ts

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, assigneeId])
}

// Same polymorphic tenantId+entityType+entityId pattern as Task — a short
// title + long description (description allows markdown for emphasis, per
// the user 2026-07-29; field names matched to Task's title/description on
// 2026-07-30 for consistency). No assignee (unlike Task, a Note isn't owned
// by anyone but its author) and no completed state — it's a record, not a
// to-do.
model Note {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  entityType  EntityType
  entityId    String
  title       String
  description String
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, entityType, entityId])
}

// @@map keeps the physical table name "PublicForm" — only the Prisma model/
// client name changed to Form (prisma.form.*), avoiding a real ALTER TABLE
// against production data for a purely cosmetic rename (same reasoning that
// kept the table name during Unit 10, now applied the other way: get the
// Form name in code without the DDL risk).
model Form {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  entityType      EntityType
  name            String
  slug            String
  fieldsConfig    String // JSON-encoded array of {key, required} — optional fields only (department/company + cf:<id>); firstName/lastName/email are always shown and required
  thankYouMessage String? // shown after a successful submit; falls back to a generic message when null
  accessMode      FormAccessMode @default(public)
  pipelineId      String? // contact forms only: which Pipeline the auto-created Opportunity lands in, first stage
  pipeline        Pipeline?      @relation(fields: [pipelineId], references: [id])
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("PublicForm")
}

model SavedView {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  entityType      EntityType
  createdByUserId String
  createdBy       User                @relation(fields: [createdByUserId], references: [id])
  name            String
  type            SavedViewType       @default(grid)
  visibility      SavedViewVisibility @default(personal)
  filters         String? // JSON-encoded array of {field, operator, value}
  sortBy          String? // JSON-encoded {field, direction}
  groupByField    String? // kanban/list only: "status" or a CustomFieldDefinition id (select type)
  createdAt       DateTime            @default(now())

  @@index([tenantId, entityType])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// One connected Google account per platform user (self-service, personal —
// not a tenant-wide/admin-configured integration). Tokens are encrypted at
// rest via lib/googleTokenEncryption.ts (its own key, mirroring how
// encryption.ts is scoped to payment data only). needsReconnect is set by
// googleCalendarAuthService.ts when Google reports the refresh token as
// revoked (invalid_grant) — the row is kept (not deleted) so the UI can show
// "reconnect" with the last-known account email instead of "not connected".
model GoogleCalendarConnection {
  id                     String   @id @default(uuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id])
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id])
  googleAccountEmail     String
  accessTokenEncrypted   String
  refreshTokenEncrypted  String
  accessTokenExpiresAt   DateTime
  scope                  String
  needsReconnect         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([tenantId])
}

// Short-lived, single-use CSRF state for the Google OAuth redirect
// round-trip. Needed (rather than a signed nonce) because the /connect
// redirect and the /callback hit are two separate, stateless Vercel function
// invocations with no shared memory — same DB-lookup shape as Session
// (opaque token -> row). Deleted on successful callback; a row older than 10
// minutes is treated as expired and rejected.
model GoogleOAuthState {
  id        String   @id @default(uuid())
  state     String   @unique
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
}

// One active Google Calendar "watch channel" per connected user — Google's
// push-notification mechanism for the reverse (Google -> Northstack) leg of
// Task sync, Tasks only (see googleCalendarWatchService.ts's schema-comment-
// length explanation of why this needs more than "a webhook route"). Google
// notifications carry no event data, only "something changed" — syncToken is
// the cursor for the follow-up events.list() call that gets the real diff.
// Channels expire and can't be renewed in place, only stopped and reopened —
// see the /api/internal/google-calendar-channels/renew cron in internal.ts.
model GoogleCalendarWatchChannel {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  channelId    String   @unique
  resourceId   String
  channelToken String
  syncToken    String?
  expiration   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Invitation {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  email           String
  role            UserRole         @default(member)
  token           String           @unique
  status          InvitationStatus @default(pending)
  invitedByUserId String
  invitedBy       User             @relation(fields: [invitedByUserId], references: [id])
  employeeId      String?
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  createdAt       DateTime         @default(now())
  expiresAt       DateTime
}
