generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  member
}

enum UserStatus {
  active
  inactive
}

enum TenantStatus {
  active
  suspended
  cancelled
}

enum AcquisitionChannel {
  organic
  paid_ads
  referral
  content
  outbound_sales
  partnership
  other
}

enum FieldType {
  text
  number
  date
  select
  email
}

enum ContractType {
  part_time
  full_time
}

enum CompensationType {
  hourly
  monthly
}

enum EntityType {
  employee
  client
  company
  contact
  opportunity
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum TimeOffAccrualMethod {
  fixed_annual
  monthly
}

enum TimeOffRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum SavedViewType {
  grid
  kanban
  list
}

enum SavedViewVisibility {
  personal
  shared
}

enum LeadStatus {
  new
  contacted
  qualified
  disqualified
}

// public: the standalone /apply/:tenantSlug/:formSlug page, no auth (today's
// only mode). internal: filled out by a logged-in team member instead of an
// outside visitor — same submit logic either way, this only gates *how* the
// form is reached, added ahead of building that reach-gate.
enum FormAccessMode {
  public
  internal
}

// Which stage of a Pipeline a given PipelineStageDefinition represents, so the
// system can trigger business rules (Opportunity reaching a `won` stage →
// Company.status moves to Customer; `lost` requires Opportunity.lossReasonId)
// without matching on the stage's tenant-renameable `name`.
enum PipelineStageOutcome {
  open
  won
  lost
}

// What kind of deal a Pipeline tracks — independent of its (renameable) name.
// `account` pipelines manage an already-identified company (require a real
// Company, never an ad-hoc one); `lead` pipelines are for unqualified/early
// prospects and tolerate a looser Company match. Drives the Company-required
// gate on Opportunity creation and which Contact detail view renders.
enum PipelineType {
  lead
  account
}

model Tenant {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  status                  TenantStatus             @default(active)
  createdAt               DateTime                 @default(now())
  companySize             String?
  industry                String?
  country                 String?
  acquisitionChannel      AcquisitionChannel?
  currency                String                   @default("USD") // ISO-4217, one currency per tenant — applies to Employee.hourlyRateCents/monthlyRateCents
  users                   User[]
  employees               Employee[]
  clients                 Client[]
  customFieldDefns        CustomFieldDefinition[]
  customFieldValues       CustomFieldValue[]
  invitations             Invitation[]
  statusDefinitions       StatusDefinition[]
  statusHistory           StatusHistoryEntry[]
  timeOffPolicies         TimeOffPolicyDefinition[]
  employeeTimeOffPolicies EmployeeTimeOffPolicy[]
  timeOffRequests         TimeOffRequest[]
  savedViews              SavedView[]
  publicForms             PublicForm[]
  fieldCatalogDefinitions FieldCatalogDefinition[]
  companies               Company[]
  contacts                Contact[]
  pipelines               Pipeline[]
  pipelineStages          PipelineStageDefinition[]
  opportunities           Opportunity[]
  opportunityContacts     OpportunityContact[]
  opportunityStageHistory OpportunityStageHistory[]
}

model User {
  id               String               @id @default(uuid())
  firstName        String
  lastName         String
  phone            String
  email            String               @unique
  passwordHash     String
  role             UserRole             @default(member)
  status           UserStatus           @default(active)
  tenantId         String?
  tenant           Tenant?              @relation(fields: [tenantId], references: [id])
  sessions         Session[]
  sentInvitations  Invitation[]
  employee         Employee?
  statusChanges    StatusHistoryEntry[]
  savedViews       SavedView[]
  acceptedTermsAt  DateTime?
  accountOwnerOfCompanies Company[]
  ownedOpportunities      Opportunity[]
}

model Employee {
  id                       String                  @id @default(uuid())
  firstName                String
  lastName                 String
  email                    String
  departmentId             String?
  departmentDefn           FieldCatalogDefinition? @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  jobTitleId               String?
  jobTitleDefn             FieldCatalogDefinition? @relation("EmployeeJobTitle", fields: [jobTitleId], references: [id])
  hourlyRateCents          Int? // owner-only visibility, enforced in listEmployees — not a schema-level concern
  monthlyRateCents         Int?
  contractType             ContractType?
  compensationType         CompensationType? // determines which of hourlyRateCents/monthlyRateCents applies
  startDate                DateTime?
  endDate                  DateTime?
  contractUrl              String? // link only (e.g. Drive/Dropbox) — no file upload support in the app today
  personalEmail            String? // distinct from `email`, which the UI now labels "Business email"
  statusId                 String
  statusDefn               StatusDefinition        @relation(fields: [statusId], references: [id])
  managerId                String?
  manager                  Employee?               @relation("EmployeeManager", fields: [managerId], references: [id])
  reports                  Employee[]              @relation("EmployeeManager")
  tenantId                 String
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id])
  createdAt                DateTime                @default(now())
  userId                   String?                 @unique
  user                     User?                   @relation(fields: [userId], references: [id])
  invitations              Invitation[]
  timeOffPolicies          EmployeeTimeOffPolicy[]
  timeOffRequestsMade      TimeOffRequest[]         @relation("TimeOffRequestEmployee")
  timeOffRequestsToApprove TimeOffRequest[]         @relation("TimeOffRequestApprover")

  @@unique([tenantId, email])
}

model Client {
  id              String               @id @default(uuid())
  firstName       String
  lastName        String
  email           String
  company         String
  statusId        String
  statusDefn      StatusDefinition     @relation(fields: [statusId], references: [id])
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  createdAt       DateTime             @default(now())

  @@unique([tenantId, email])
}

// Clients redesign (Company/Contact/Pipeline/Opportunity) — see docs/tareas-desarrollo.md
// lines 389-411 for the full spec. Company/Contact replace the flat `Client` model
// above (kept as-is for now — the data migration from Client to Company+Contact is
// its own later, separate step, not part of this schema-only pass).

model Company {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  name            String
  industry        String?
  website         String?
  phone           String?
  billingAddress  String? // same field the future Payments module will need — not duplicated
  size            String? // employee-count range, free text, optional
  accountOwnerId  String?
  accountOwner    User?            @relation(fields: [accountOwnerId], references: [id])
  statusId        String // lifecycle status (Prospect/Customer/Churned) — StatusDefinition-based
  statusDefn      StatusDefinition @relation(fields: [statusId], references: [id]) // like Employee/Client, but never manually edited: derived from Opportunity/Contract events
  createdAt       DateTime         @default(now())
  contacts        Contact[]
  opportunities   Opportunity[]

  @@index([tenantId])
}

model Contact {
  id               String                  @id @default(uuid())
  tenantId         String
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  firstName        String
  lastName         String
  email            String
  phone            String?
  companyId        String? // optional — a lead may not have a confirmed Company yet
  company          Company?                @relation(fields: [companyId], references: [id])
  title            String? // role/title within the company
  isPrimary        Boolean                 @default(false)
  leadStatus       LeadStatus? // only meaningful for leads captured via a public Form
  leadSourceId     String?
  leadSource       FieldCatalogDefinition? @relation(fields: [leadSourceId], references: [id])
  createdAt        DateTime                @default(now())
  opportunityLinks OpportunityContact[]

  @@unique([tenantId, email])
  @@index([tenantId, companyId])
}

model Pipeline {
  id            String                    @id @default(uuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  name          String
  type          PipelineType              @default(lead)
  order         Int                       @default(0)
  isActive      Boolean                   @default(true) // archived when false
  createdAt     DateTime                  @default(now())
  stages        PipelineStageDefinition[]
  opportunities Opportunity[]
  forms         PublicForm[]

  @@index([tenantId])
}

model PipelineStageDefinition {
  id            String                    @id @default(uuid())
  tenantId      String
  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  pipelineId    String
  pipeline      Pipeline                  @relation(fields: [pipelineId], references: [id])
  name          String
  color         String?
  order         Int                       @default(0)
  outcome       PipelineStageOutcome      @default(open)
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  opportunities Opportunity[]
  stageHistory  OpportunityStageHistory[]

  @@index([tenantId, pipelineId])
}

model Opportunity {
  id                 String                    @id @default(uuid())
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id])
  pipelineId         String
  pipeline           Pipeline                  @relation(fields: [pipelineId], references: [id])
  stageId            String
  stage              PipelineStageDefinition   @relation(fields: [stageId], references: [id])
  name               String
  amountCents        Int
  currency           String // ISO-4217, explicit per Opportunity — not the tenant-wide Employee compensation currency
  estimatedCloseDate DateTime?
  ownerId            String
  owner              User                      @relation(fields: [ownerId], references: [id])
  lossReasonId       String? // required at the application layer when stage.outcome === 'lost' — not enforced at the DB level
  lossReason         FieldCatalogDefinition?   @relation(fields: [lossReasonId], references: [id])
  nextStepDate       DateTime?
  nextStepNote       String?
  createdAt          DateTime                  @default(now())
  contactLinks       OpportunityContact[]
  stageHistory       OpportunityStageHistory[]

  @@index([tenantId, pipelineId])
  @@index([tenantId, companyId])
}

model OpportunityContact {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id])
  role          String? // e.g. "decisor" — free text, not a catalog (low cardinality, per-opportunity)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, contactId])
  @@index([tenantId])
}

// Real stageId FK (not a denormalized name snapshot like StatusHistoryEntry) —
// deliberate: the spec asks for stageId specifically, so time-in-stage reporting
// can join back to the live PipelineStageDefinition (color/outcome/order), unlike
// Status's audit-log-style history which snapshots names to survive renames.
model OpportunityStageHistory {
  id            String                  @id @default(uuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  opportunityId String
  opportunity   Opportunity             @relation(fields: [opportunityId], references: [id])
  stageId       String
  stage         PipelineStageDefinition @relation(fields: [stageId], references: [id])
  enteredAt     DateTime                @default(now())

  @@index([tenantId, opportunityId])
}

model StatusDefinition {
  id         String               @id @default(uuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  entityType EntityType
  name       String
  color      String?
  order      Int                  @default(0)
  isDefault  Boolean              @default(false)
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  employees  Employee[]
  clients    Client[]
  companies  Company[]

  @@index([tenantId, entityType])
}

// Generic tenant-scoped catalog, shared by Department and Job Title (the two Employee
// fields that needed to go from free text to a standardized dropdown). Status is
// deliberately NOT on this mechanism — it's a live, heavily-used feature (Kanban
// grouping, StatusHistoryEntry, isDefault/color) and retrofitting it onto a shared
// model would be a real-data migration for comparatively low reward. See
// docs/tareas-desarrollo.md, Tier 2, for the reasoning.
enum CatalogKind {
  department
  jobTitle
  leadSource
  lossReason
}

model FieldCatalogDefinition {
  id                        String       @id @default(uuid())
  tenantId                  String
  tenant                    Tenant       @relation(fields: [tenantId], references: [id])
  kind                      CatalogKind
  name                      String
  order                     Int          @default(0)
  isActive                  Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  employeesByDepartment     Employee[]   @relation("EmployeeDepartment")
  employeesByJobTitle       Employee[]   @relation("EmployeeJobTitle")
  contactsByLeadSource      Contact[]
  opportunitiesByLossReason Opportunity[]

  @@index([tenantId, kind])
}

model StatusHistoryEntry {
  id              String     @id @default(uuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  entityType      EntityType
  entityId        String
  fromStatusName  String?
  toStatusName    String
  changedByUserId String
  changedBy       User       @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime   @default(now())

  @@index([tenantId, entityType, entityId])
}

model TimeOffPolicyDefinition {
  id                  String                  @id @default(uuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  name                String
  color               String?
  accrualMethod       TimeOffAccrualMethod    @default(fixed_annual)
  daysPerYear         Float
  isPaid              Boolean                 @default(true)
  requiresApproval    Boolean                 @default(true)
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  employeeAssignments EmployeeTimeOffPolicy[]
  requests            TimeOffRequest[]

  @@index([tenantId])
}

model TimeOffRequest {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  employeeId     String
  employee       Employee              @relation("TimeOffRequestEmployee", fields: [employeeId], references: [id])
  timeOffPolicyId String
  timeOffPolicy  TimeOffPolicyDefinition @relation(fields: [timeOffPolicyId], references: [id])
  startDate      DateTime
  endDate        DateTime
  daysRequested  Float
  note           String?
  status         TimeOffRequestStatus  @default(pending)
  approverId     String?
  approver       Employee?             @relation("TimeOffRequestApprover", fields: [approverId], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime              @default(now())

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model EmployeeTimeOffPolicy {
  id             String                  @id @default(uuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  employeeId     String
  employee       Employee                @relation(fields: [employeeId], references: [id])
  timeOffPolicyId String
  timeOffPolicy  TimeOffPolicyDefinition @relation(fields: [timeOffPolicyId], references: [id])
  assignedAt     DateTime                @default(now())

  @@unique([employeeId, timeOffPolicyId])
  @@index([tenantId])
}

model CustomFieldDefinition {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  name        String
  entityType  EntityType
  fieldType   FieldType
  options     String?            // JSON-encoded options for select fields
  required    Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  values      CustomFieldValue[]
}

model CustomFieldValue {
  id                      String                  @id @default(uuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id])
  customFieldDefinitionId String
  customFieldDefinition   CustomFieldDefinition   @relation(fields: [customFieldDefinitionId], references: [id])
  entityType              EntityType
  entityId                String
  value                   String
  createdAt               DateTime                @default(now())

  @@index([tenantId, entityType, entityId])
}

// Conceptually "Form" per the redesign spec (no longer exclusively public
// once accessMode:internal exists) — kept as the PublicForm table name to
// avoid a risky rename via `db push` (no real migration tooling in this
// project, see the safe-migration protocol) for a change with no functional
// benefit on its own.
model PublicForm {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  entityType   EntityType
  name         String
  slug         String
  fieldsConfig String         // JSON-encoded array of {key, required} — optional fields only (department/company + cf:<id>); firstName/lastName/email are always shown and required
  thankYouMessage String?     // shown after a successful submit; falls back to a generic message when null
  accessMode   FormAccessMode @default(public)
  pipelineId   String?        // contact forms only: which Pipeline the auto-created Opportunity lands in, first stage
  pipeline     Pipeline?      @relation(fields: [pipelineId], references: [id])
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model SavedView {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  entityType      EntityType
  createdByUserId String
  createdBy       User                @relation(fields: [createdByUserId], references: [id])
  name            String
  type            SavedViewType       @default(grid)
  visibility      SavedViewVisibility @default(personal)
  filters         String?             // JSON-encoded array of {field, operator, value}
  sortBy          String?             // JSON-encoded {field, direction}
  groupByField    String?             // kanban/list only: "status" or a CustomFieldDefinition id (select type)
  createdAt       DateTime            @default(now())

  @@index([tenantId, entityType])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Invitation {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  email           String
  role            UserRole         @default(member)
  token           String           @unique
  status          InvitationStatus @default(pending)
  invitedByUserId String
  invitedBy       User             @relation(fields: [invitedByUserId], references: [id])
  employeeId      String?
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  createdAt       DateTime         @default(now())
  expiresAt       DateTime
}
